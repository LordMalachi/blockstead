# Copy this file to docker.env and pass it with:
# docker compose --env-file docker.env up --build -d

# Dashboard access stays on this computer by default.
BLOCKSTEAD_DASHBOARD_BIND=127.0.0.1
BLOCKSTEAD_DASHBOARD_PORT=8765

# Minecraft is reachable on the local network by default.
MINECRAFT_BIND=0.0.0.0
MINECRAFT_PORT=25565

# If exposing the dashboard on your LAN, add its exact browser URL here, for example:
# BLOCKSTEAD_ALLOWED_ORIGINS=http://192.168.1.25:8765
BLOCKSTEAD_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Keep false for ordinary local HTTP. Set true only when the dashboard is behind HTTPS.
BLOCKSTEAD_SECURE_COOKIES=false

# Central Discord relay. Leave the bot token on the relay VM; never put it in
# this host's docker.env.
BLOCKSTEAD_DISCORD_APPLICATION_ID=
BLOCKSTEAD_DISCORD_PUBLIC_KEY=
BLOCKSTEAD_DISCORD_RELAY_URL=
BLOCKSTEAD_DISCORD_RELAY_INSTALLATION_ID=
BLOCKSTEAD_DISCORD_RELAY_CONNECTOR_SECRET=
# Optional CA bundle path inside the container for a pinned relay certificate.
BLOCKSTEAD_DISCORD_RELAY_CA_FILE=

# Where Blockstead's data (accounts, backups) and Minecraft servers live on
# this computer, as real folders rather than Docker-managed volumes -- so
# Finder/Explorer or your own tools can reach them directly. Left unset, they
# default to blockstead-data/ and blockstead-servers/ next to this file.
# scripts/docker-up.sh fills these in with a folder in your home directory
# the first time it creates this file. To move existing data, stop Blockstead
# first, then move both folders and update the paths below to match.
# BLOCKSTEAD_HOST_DATA_DIR=/absolute/path/to/blockstead-data
# BLOCKSTEAD_HOST_SERVERS_DIR=/absolute/path/to/blockstead-servers
