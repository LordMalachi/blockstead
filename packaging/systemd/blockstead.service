[Unit]
Description=Blockstead Minecraft server manager
After=network.target

[Service]
Type=simple
User=blockstead
Group=blockstead
WorkingDirectory=/opt/blockstead
EnvironmentFile=/etc/blockstead/blockstead.env
# The interpreter is started directly. A virtual environment console script
# such as venv/bin/uvicorn carries the absolute interpreter path it was built
# with, and the installer builds the environment in a staging directory that is
# swapped into place, so those scripts point at a path that no longer exists
# once the swap is cleaned up. venv/bin/python is a symlink to the system
# interpreter and stays correct wherever the tree is published.
ExecStart=/opt/blockstead/venv/bin/python -m uvicorn blockstead.app:app --host ${BLOCKSTEAD_BIND_HOST} --port ${BLOCKSTEAD_PORT}
Restart=on-failure
KillMode=mixed
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ReadWritePaths=/var/lib/blockstead /var/log/blockstead /srv/minecraft

[Install]
WantedBy=multi-user.target
