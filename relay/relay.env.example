# Copy to relay.env on the relay VM. Never commit relay.env.
RELAY_APPLICATION_ID=1535816544951476324
RELAY_BOT_TOKEN=
RELAY_BIND_HOST=0.0.0.0
RELAY_PORT=8080
RELAY_DATABASE_PATH=/var/lib/blockstead-relay/relay.db
RELAY_STALE_AFTER_SECONDS=180
# Set these after copying an IP-address certificate into ./tls. Leave blank
# for local HTTP testing.
RELAY_TLS_CERT_FILE=
RELAY_TLS_KEY_FILE=
