BLOCKSTEAD_BIND_HOST=127.0.0.1
BLOCKSTEAD_PORT=8765
BLOCKSTEAD_DATA_DIR=./data
BLOCKSTEAD_SERVER_ROOT=./fixtures/servers
BLOCKSTEAD_SECURE_COOKIES=false
BLOCKSTEAD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Discord relay application metadata. The bot token belongs only on the central
# relay service and must not be placed in this host environment.
BLOCKSTEAD_DISCORD_APPLICATION_ID=
BLOCKSTEAD_DISCORD_PUBLIC_KEY=
BLOCKSTEAD_DISCORD_RELAY_URL=
# These are generated automatically in the data directory when omitted.
BLOCKSTEAD_DISCORD_RELAY_INSTALLATION_ID=
BLOCKSTEAD_DISCORD_RELAY_CONNECTOR_SECRET=
# Optional CA bundle for a private/pinned relay certificate.
BLOCKSTEAD_DISCORD_RELAY_CA_FILE=
